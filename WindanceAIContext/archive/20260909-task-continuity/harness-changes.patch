+def task_handoff(task: dict[str, Any]) -> dict[str, Any]:
+    """A current record, not vector-retrieved or channel-local conversation prose."""
+    with db() as conn:
+        notes = conn.execute(
+            "SELECT id, note, author, channel, created_at FROM staff_task_notes WHERE task_id=? ORDER BY id",
+            (task["id"],),
+        ).fetchall()
+    return {**task, "handoff_notes": [dict(row) for row in notes]}
+
+
+def resolve_task_reference(reference: str, requester: str = "William") -> dict[str, Any] | None:
+    ref = reference.strip().strip('"').lstrip("#")
+    if re.fullmatch(r"[a-fA-F0-9-]{4,36}|VEGA-[A-Z0-9-]+", ref, re.I):
+        task = find_staff_task(ref)
+        return task_handoff(task) if task and task["requester"].casefold() == requester.casefold() else None
+    # Exact titles are voice-friendly. Never guess among duplicates or SQL wildcards.
+    with db() as conn:
+        rows = conn.execute(
+            "SELECT * FROM staff_tasks WHERE lower(title)=lower(?) AND lower(requester)=lower(?) LIMIT 2",
+            (ref, requester),
+        ).fetchall()
+    return task_handoff(dict(rows[0])) if len(rows) == 1 else None
+
+
+def append_task_note(task_id: str, note: str, author: str = "William", channel: str = "api") -> dict[str, Any]:
+    task = resolve_task_reference(task_id, author)
+    if not task:
+        raise HTTPException(status_code=404, detail="No unique task for this requester; use its task ID.")
+    clean = note.strip()
+    if not clean or len(clean) > 4000 or memory_looks_secret(clean):
+        raise HTTPException(status_code=422, detail="Use a nonempty handoff note of at most 4000 characters without secrets.")
+    with db() as conn:
+        conn.execute("INSERT INTO staff_task_notes (task_id,note,author,channel,created_at) VALUES (?,?,?,?,?)",
+                     (task["id"], clean, author, channel, now()))
+        conn.execute("UPDATE staff_tasks SET updated_at=? WHERE id=?", (now(), task["id"]))
+        conn.commit()
+    audit("staff_task_note_added", {"task_id": task["id"], "author": author, "channel": channel})
+    return task_handoff(find_staff_task(task["id"]))
+
+
+def render_task_handoff(task: dict[str, Any]) -> str:
+    lines = [f"{task['title']} — #{task['id'][:8]}", f"Owner: {task['assignee']}. Status: {task['status']}.",
+             f"Updated: {task['updated_at']}", f"Request: {task['request']}",
+             f"Latest worker record: {task.get('result') or 'No worker result yet.'}"]
+    notes = task.get("handoff_notes") or []
+    if notes:
+        lines.append("Handoff notes (latest five; full history is on the task record):")
+        lines.extend(f"- {n['created_at']}: {n['note']}" for n in notes[-5:])
+    return "\n".join(lines)
+
+
+def task_continuity_reply(text: str, user: str, channel: str) -> dict[str, Any] | None:
+    # Shared operational commands are limited to William; mailbox/persona boundaries stay separate.
+    if user.casefold() != "william":
+        return None
+    clean = re.sub(r"^\s*(?:vega|codex|herald|harold|max)[,:]?\s+", "", text, flags=re.I).strip()
+    note = re.fullmatch(r"(?:update|note for|add a note to)\s+task\s+(.+?)\s*:\s*(.+)", clean, re.I | re.S)
+    lookup = re.fullmatch(r"(?:show\s+task|task|(?:what is|what's)\s+the\s+status\s+of\s+task|status\s+(?:of\s+)?task)\s+(.+?)\s*[?.!]*", clean, re.I)
+    listing = re.fullmatch(r"(?:show\s+(?:my\s+)?work|my\s+work|staff\s+tasks|show\s+(?:my\s+)?tasks)\s*[?.!]*", clean, re.I)
+    if not (note or lookup or listing):
+        return None
+    if listing:
+        # Filter before limiting so other requesters cannot crowd out William's work.
+        with db() as conn:
+            rows = conn.execute("SELECT * FROM staff_tasks WHERE lower(requester)='william' ORDER BY CASE status WHEN 'running' THEN 0 WHEN 'partial' THEN 1 WHEN 'blocked' THEN 2 WHEN 'pending' THEN 3 ELSE 4 END, updated_at DESC LIMIT 20").fetchall()
+        tasks = [dict(row) for row in rows]
+        reply = "Your work (up to 20 tasks):\n" + "\n".join(f"- {t['title']} — #{t['id'][:8]} — {t['assignee']}: {t['status']}" for t in tasks) if tasks else "No recorded work was found."
+        return {"reply": reply, "tasks": tasks, "provider": "task-ledger", "model": "none", "agent": "Vega"}
+    reference = (note or lookup).group(1)
+    task = resolve_task_reference(reference)
+    if not task:
+        return {"reply": "I could not resolve exactly one of your tasks. Say 'show my work', then use its exact title or task ID.", "provider": "task-ledger", "model": "none", "agent": "Vega"}
+    if note:
+        task = append_task_note(task["id"], note.group(2), "William", channel)
+        reply = f"Saved a handoff note on {task['title']} (#{task['id'][:8]}). It will be included when the task is next dispatched. This does not restart a worker or authorize an external action."
+    else:
+        reply = render_task_handoff(task)
+    return {"id": task["id"], "reply": reply, "task": task, "provider": "task-ledger", "model": "none", "agent": "Vega"}
+
+
