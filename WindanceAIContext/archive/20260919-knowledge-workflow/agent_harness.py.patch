+IDEA_STATES = {"active", "hold", "discussion", "archived"}
+
+
+def create_idea(text: str, channel: str, user: str) -> dict[str, Any]:
+    if memory_looks_secret(text):
+        raise ValueError("Remove secret or credential material before saving this idea.")
+    return create_capture(text, channel, user, "active")
+
+
+def list_ideas(state: str = "", limit: int = 50, offset: int = 0) -> list[dict[str, Any]]:
+    if state and state not in IDEA_STATES:
+        raise ValueError("Use active, hold, discussion, or archived")
+    query = "SELECT id, original_text, state, created_at, updated_at FROM captures WHERE state IN ('active','hold','discussion','archived')"
+    args = []
+    if state:
+        query += " AND state=?"
+        args.append(state)
+    query += " ORDER BY created_at, id LIMIT ? OFFSET ?"
+    args.extend([max(1, min(int(limit), 100)), max(0, int(offset))])
+    with db() as conn:
+        rows = [dict(row) for row in conn.execute(query, args).fetchall()]
+        for row in rows:
+            row["history"] = [dict(x) for x in conn.execute("SELECT event_type,actor,note,created_at FROM capture_events WHERE capture_id=? ORDER BY id", (row["id"],))]
+        return rows
+
+
+def review_idea(capture_id: str, state: str, reason: str, actor: str) -> dict[str, Any]:
+    if state not in IDEA_STATES or not reason.strip() or len(reason) > 4000:
+        raise ValueError("A valid idea state and a reason of 1–4000 characters are required")
+    if memory_looks_secret(reason):
+        raise ValueError("Do not store secret material in a review")
+    changed = now()
+    with db() as conn:
+        row = conn.execute("SELECT state FROM captures WHERE id=?", (capture_id,)).fetchone()
+        if row is None or row["state"] not in IDEA_STATES:
+            raise KeyError("Idea not found")
+        conn.execute("UPDATE captures SET state=?,updated_at=? WHERE id=?", (state, changed, capture_id))
+        conn.execute("INSERT INTO capture_events(capture_id,event_type,actor,note,created_at) VALUES(?,?,?,?,?)", (capture_id, "idea_review", actor, f"{row['state']} -> {state}: {reason.strip()}", changed))
+        conn.commit()
+    return {"id": capture_id, "state": state, "updated_at": changed, "reason": reason.strip()}
+
+
+@app.post("/ideas")
+def post_idea(payload: dict[str, Any], authorization: str | None = Header(default=None)):
+    require_token(authorization)
+    try:
+        return create_idea(str(payload.get("text", "")), str(payload.get("channel", "api")), str(payload.get("user", "William")))
+    except ValueError as exc:
+        raise HTTPException(400, str(exc)) from exc
+
+
+@app.get("/ideas")
+def get_ideas(state: str = "", limit: int = 50, offset: int = 0, authorization: str | None = Header(default=None)):
+    require_token(authorization)
+    try:
+        return {"items": list_ideas(state, limit, offset)}
+    except ValueError as exc:
+        raise HTTPException(400, str(exc)) from exc
+
+
+@app.post("/ideas/{capture_id}/review")
+def post_idea_review(capture_id: str, payload: dict[str, Any], authorization: str | None = Header(default=None)):
+    require_token(authorization)
+    try:
+        return review_idea(capture_id, str(payload.get("state", "")), str(payload.get("reason", "")), str(payload.get("actor", "Vega")))
+    except ValueError as exc:
+        raise HTTPException(400, str(exc)) from exc
+    except KeyError as exc:
+        raise HTTPException(404, "Idea not found") from exc
+
