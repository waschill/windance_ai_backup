+def _mission_control_tasks(limit: int = 50) -> dict[str, Any]:
+    """Read the Harness staff queue without allowing dashboard writes."""
+    db_path = Path.home() / ".local" / "share" / "agent-harness" / "harness.db"
+    if not db_path.is_file():
+        return {"tasks": [], "source_available": False}
+    with sqlite3.connect(str(db_path), timeout=2.0) as conn:
+        conn.row_factory = sqlite3.Row
+        rows = conn.execute(
+            """
+            SELECT id, assignee, title, status, result, source, updated_at
+            FROM staff_tasks
+            WHERE lower(status) IN ('pending','accepted','active','dispatching','in_progress','running','working','blocked','complete','completed','failed','succeeded')
+            ORDER BY CASE WHEN lower(status) IN ('pending','accepted','active','dispatching','in_progress','running','working') THEN 0 ELSE 1 END, updated_at DESC
+            LIMIT ?
+            """,
+            (max(1, min(int(limit), 100)),),
+        ).fetchall()
+    tasks = []
+    for row in rows:
+        status = str(row["status"] or "unknown").lower()
+        text = str(row["result"] or "").strip()
+        tasks.append({
+            "id": str(row["id"]),
+            "title": str(row["title"] or "Untitled task")[:240],
+            "assignee": str(row["assignee"] or "Unassigned")[:80],
+            "target_host": None,
+            "status": status,
+            "is_complete": status in {"complete", "completed", "succeeded"},
+            "last_progress": text[:500] or None,
+            "verification_evidence": text[:700] or None,
+            "blocker": text[:700] if status in {"blocked", "failed", "cancelled"} else None,
+            "is_escalation": str(row["source"] or "").startswith("forge-escalation:"),
+            "updated_at": str(row["updated_at"] or ""),
+        })
+    return {"tasks": tasks, "source_available": True}
 
 
