+def _wake_onnxruntime_spec(
+    system: str = sys.platform,
+    machine: str = platform.machine(),
+) -> str:
+    """Return the newest ONNX Runtime pin available for this platform.
+
+    ONNX Runtime 1.27 has no macOS x86_64 wheel. Requiring it made Hermes
+    repeatedly attempt an impossible lazy install on Intel Macs even when the
+    compatible 1.23.2 runtime was already installed. Keep the current pin on
+    supported platforms and use the final Intel-macOS wheel only there.
+    """
+    if system == "darwin" and machine.lower() in {"x86_64", "amd64"}:
+        return "onnxruntime==1.23.2"
+    return "onnxruntime==1.27.0"
