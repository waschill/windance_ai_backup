+  camera.x = anchorX - before.x * camera.scale;
+  camera.y = anchorY - before.y * camera.scale;
+}
+function resetView() { camera = {x:0, y:0, scale:1}; }
+function initPositions() {
+  const w = innerWidth, h = innerHeight, cx = w/2, cy = h/2;
+  nodes.forEach((n,i) => {
+    if (n.x == null) {
+      const angle = (i / Math.max(1,nodes.length)) * Math.PI * 2;
+      const r = n.hub ? Math.min(w,h)*0.22 : Math.min(w,h)*(0.18 + Math.random()*0.28);
+      n.x = cx + Math.cos(angle)*r + (Math.random()-.5)*80;
+      n.y = cy + Math.sin(angle)*r + (Math.random()-.5)*80;
+      n.vx = 0; n.vy = 0;
+    }
+  });
+}
+function applyFilter() {
+  if (!raw) return;
+  const f = sourceFilter.value;
+  const allowed = new Set();
+  raw.nodes.forEach(n => { if (!f || n.source_type === f || n.id === 'source:'+f || n.source_type === 'source_hub') allowed.add(n.id); });
+  nodes = raw.nodes.filter(n => allowed.has(n.id)).map(n => ({...n}));
+  const nodeIds = new Set(nodes.map(n => n.id));
+  links = raw.links.filter(l => nodeIds.has(l.source) && nodeIds.has(l.target));
+  initPositions();
+  document.getElementById('shown').textContent = nodes.length;
+  document.getElementById('links').textContent = links.length;
+}
+async function loadGraph() {
+  const limit = encodeURIComponent(limitInput.value || '160');
+  const res = await fetch('/api/memory/graph-browser?limit=' + limit);
+  const data = await res.json().catch(() => ({detail:'Non-JSON response'}));
+  if (!res.ok) throw new Error(data.detail || 'HTTP ' + res.status);
+  raw = data;
+  document.getElementById('total').textContent = data.stats.total;
+  document.getElementById('embedded').textContent = data.stats.embedded;
+  const types = [...new Set(data.nodes.filter(n => !n.hub).map(n => n.source_type))].sort();
+  sourceFilter.innerHTML = '<option value="">All memory</option>' + types.map(t => `<option value="${t}">${t.replaceAll('_',' ')}</option>`).join('');
+  legend.innerHTML = types.map(t => `<span class="chip"><span class="dot" style="background:${colorFor(t)}"></span>${t.replaceAll('_',' ')}</span>`).join('');
+  selected = null;
+  details.textContent = 'Tap/click a node. Drag nodes around. Hubs are memory source types; smaller nodes are actual vector memories.';
+  applyFilter();
+}
+function step() {
+  const w = innerWidth, h = innerHeight, center = screenToWorld(w/2, h/2), cx = center.x, cy = center.y;
+  const byId = Object.fromEntries(nodes.map(n => [n.id,n]));
+  const largeGraph = nodes.length > 350;
+  links.forEach(l => {
+    const a = byId[l.source], b = byId[l.target]; if (!a || !b) return;
+    const dx = b.x-a.x, dy = b.y-a.y, dist = Math.sqrt(dx*dx+dy*dy) || 1;
+    const target = l.kind === 'source' ? 130 : 95;
+    const force = (dist-target) * (l.kind === 'source' ? .0009 : .0018);
+    const fx = dx/dist*force, fy = dy/dist*force;
+    if (!a.fixed) { a.vx += fx; a.vy += fy; }
+    if (!b.fixed) { b.vx -= fx; b.vy -= fy; }
+  });
+  // A full pairwise physics simulation is pleasant for a few hundred nodes,
+  // but becomes a browser-side million-pair loop for the complete library.
+  // Large views remain fully interactive; they simply use the source links
+  // for layout rather than repelling every dot from every other dot.
+  if (!largeGraph) for (let i=0;i<nodes.length;i++) for (let j=i+1;j<nodes.length;j++) {
+    const a=nodes[i], b=nodes[j], dx=b.x-a.x, dy=b.y-a.y, d2=dx*dx+dy*dy || 1;
+    const f = Math.min(1.8, 900/d2);
+    if (!a.fixed) { a.vx -= dx*f*.006; a.vy -= dy*f*.006; }
+    if (!b.fixed) { b.vx += dx*f*.006; b.vy += dy*f*.006; }
+  }
+  nodes.forEach(n => {
+    if (!n.fixed) {
+      n.vx += (cx-n.x) * (n.hub ? .0008 : .00025);
+      n.vy += (cy-n.y) * (n.hub ? .0008 : .00025);
+      n.vx *= .89; n.vy *= .89; n.x += n.vx; n.y += n.vy;
+    }
+  });
+}
+function draw() {
+  ctx.clearRect(0,0,innerWidth,innerHeight);
+  ctx.save();
+  ctx.translate(camera.x, camera.y);
+  ctx.scale(camera.scale, camera.scale);
+  const byId = Object.fromEntries(nodes.map(n => [n.id,n]));
+  links.forEach(l => {
+    const a=byId[l.source], b=byId[l.target]; if (!a||!b) return;
+    ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y);
+    ctx.strokeStyle = l.kind === 'similarity' ? `rgba(251,191,36,${Math.max(.1,(l.score-.70)*1.8)})` : 'rgba(148,163,184,.16)';
+    ctx.lineWidth = l.kind === 'similarity' ? 1.2 : .8; ctx.stroke();
+  });
+  nodes.forEach(n => {
+    const c = colorFor(n.source_type);
+    const r = n.radius || 9;
+    const g = ctx.createRadialGradient(n.x,n.y,1,n.x,n.y,r*3.2);
+    g.addColorStop(0,c); g.addColorStop(.38,c+'cc'); g.addColorStop(1,'rgba(2,6,23,0)');
+    ctx.fillStyle = g; ctx.beginPath(); ctx.arc(n.x,n.y,r*3.2,0,Math.PI*2); ctx.fill();
+    ctx.fillStyle = c; ctx.beginPath(); ctx.arc(n.x,n.y,r,0,Math.PI*2); ctx.fill();
+    ctx.strokeStyle = selected && selected.id === n.id ? '#fff' : 'rgba(255,255,255,.65)';
+    ctx.lineWidth = selected && selected.id === n.id ? 3 : 1; ctx.stroke();
+    if (n.hub || r > 12) {
+      ctx.fillStyle = 'rgba(248,250,252,.88)'; ctx.font = n.hub ? '700 13px system-ui' : '600 11px system-ui';
+      ctx.fillText((n.title || '').slice(0,28), n.x + r + 5, n.y + 4);
+    }
+  });
+  ctx.restore();
+  ctx.fillStyle = 'rgba(226,232,240,.78)';
+  ctx.font = '700 12px system-ui';
+  ctx.fillText(`Zoom ${Math.round(camera.scale * 100)}%`, 18, innerHeight - 34);
+}
+function animate() { for (let i=0;i<2;i++) step(); draw(); requestAnimationFrame(animate); }
+function hit(x,y) {
+  const p = screenToWorld(x,y);
+  return [...nodes].reverse().find(n => Math.hypot(n.x-p.x,n.y-p.y) <= ((n.radius || 9) + 8) / Math.sqrt(camera.scale));
+}
+function show(n) {
+  selected = n;
+  details.innerHTML = `<div class="title">${(n.title||n.id).replace(/[<>&]/g, s => ({'<':'&lt;','>':'&gt;','&':'&amp;'}[s]))}</div>
+    <div class="muted">${n.source_type || ''}${n.updated_at ? ' · ' + n.updated_at : ''}${n.count ? ' · ' + n.count + ' items' : ''}</div>
+    <p class="excerpt">${(n.excerpt||'No excerpt.').replace(/[<>&]/g, s => ({'<':'&lt;','>':'&gt;','&':'&amp;'}[s]))}</p>`;
+}
+canvas.addEventListener('pointerdown', e => {
+  pointer={x:e.clientX,y:e.clientY};
+  const n=hit(pointer.x,pointer.y);
+  canvas.setPointerCapture?.(e.pointerId);
+  if(n){ dragging=n; n.fixed=true; show(n); }
+  else { panning = true; }
+});
+canvas.addEventListener('pointermove', e => {
+  const prev = pointer;
+  pointer={x:e.clientX,y:e.clientY};
+  if(dragging){
+    const p = screenToWorld(pointer.x,pointer.y);
+    dragging.x=p.x; dragging.y=p.y; dragging.vx=0; dragging.vy=0;
+  } else if (panning) {
+    camera.x += pointer.x - prev.x;
+    camera.y += pointer.y - prev.y;
+  }
+});
+canvas.addEventListener('wheel', e => {
+  e.preventDefault();
+  const factor = Math.exp(-e.deltaY * 0.0012);
+  setZoom(camera.scale * factor, e.clientX, e.clientY);
+}, {passive:false});
+addEventListener('pointerup', e => {
+  if(dragging){ dragging.fixed=false; dragging=null; }
+  panning = false;
+  canvas.releasePointerCapture?.(e.pointerId);
+});
+sourceFilter.addEventListener('change', applyFilter);
+document.getElementById('zoomOut').addEventListener('click', () => setZoom(camera.scale / 1.25));
+document.getElementById('zoomIn').addEventListener('click', () => setZoom(camera.scale * 1.25));
+document.getElementById('zoomReset').addEventListener('click', resetView);
+document.getElementById('reload').addEventListener('click', () => loadGraph().catch(err => details.textContent='Error: '+err.message));
+loadGraph().catch(err => details.textContent='Error: '+err.message);
+animate();
+  </script>
+</body>
+</html>"""
+    return HTMLResponse(html_doc, headers={"Cache-Control": "no-store"})
+
+@app.get("/api/memory/graph-browser")
+async def herald_memory_graph_browser(request: Request):
+    query = request.url.query
+    target = "http://127.0.0.1:8791/memory/vector/graph" + (f"?{query}" if query else "")
+    req = urllib.request.Request(target, method="GET")
+    try:
+        with urllib.request.urlopen(req, timeout=30) as resp:
+            return JSONResponse(json.loads(resp.read().decode("utf-8")))
+    except urllib.error.HTTPError as exc:
+        detail = exc.read().decode("utf-8", "replace")[:2000]
+        return JSONResponse({"detail": detail}, status_code=exc.code)
+    except Exception as exc:
+        return JSONResponse({"detail": str(exc)[:1000]}, status_code=502)
+
 mount_spa(app)
 
 
