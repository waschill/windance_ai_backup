+def _windance_harness_headers(content_type: str) -> dict[str, str]:
+    token_path = Path.home() / ".config" / "agent-harness" / "voice-shortcut-token"
+    try: token = token_path.read_text(encoding="utf-8").strip()
+    except Exception: token = ""
+    headers = {"Content-Type": content_type}
+    if token: headers["Authorization"] = f"Bearer {token}"
+    return headers
+def _windance_external_voice_allowed(request: Request) -> bool:
+    token_path = Path.home() / ".config" / "agent-harness" / "voice-shortcut-token"
+    try: expected = token_path.read_text(encoding="utf-8").strip()
+    except Exception: expected = ""
+    auth = request.headers.get("authorization", "")
+    parts = auth.split(None, 1)
+    supplied = parts[1].strip() if len(parts) == 2 and parts[0].lower() == "bearer" else request.headers.get("x-herald-voice-token", "").strip()
+    return bool(expected and supplied and secrets.compare_digest(expected, supplied))
