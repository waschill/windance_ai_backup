 logger = logging.getLogger(__name__)
 
 
+def windance_transport_recovery(base_url: str, query: str):
+    """Retry only the configured Windance service with the native transport.
+
+    macOS service-launched Python can fail a LAN connection which curl can
+    reach. No provider change, redirects, shell, curlrc, or credentials.
+    """
+    if base_url != "http://192.168.36.20:8888":
+        return None
+    try:
+        with tempfile.TemporaryFile() as output:
+            result = subprocess.run(
+                ["/usr/bin/curl", "--disable", "--silent", "--show-error", "--fail",
+                 "--noproxy", "*", "--proto", "=http", "--connect-timeout", "5",
+                 "--max-time", "20", "--max-filesize", "2097152", "--limit-rate", "100K", "--get",
+                 "--data-urlencode", "q=" + query, "--data-urlencode", "format=json",
+                 "--data-urlencode", "pageno=1", base_url + "/search"],
+                stdout=output, stderr=subprocess.DEVNULL, timeout=23, check=False,
+            )
+            if result.returncode:
+                logger.warning("SearXNG native recovery failed: curl exit %s", result.returncode)
+                return None
+            output.seek(0)
+            raw = output.read(2097153)
+        if len(raw) > 2097152:
+            return None
+        data = json.loads(raw)
+        if not isinstance(data, dict) or not isinstance(data.get('results'), list):
+            return None
+        logger.info("SearXNG recovered using native transport to the same service")
+        return data
+    except (OSError, subprocess.TimeoutExpired, ValueError) as exc:
+        logger.warning("SearXNG native recovery failed: %s", type(exc).__name__)
+        return None
+
+
 class SearXNGWebSearchProvider(BaseWebSearchProvider):
     """Search via a user-hosted SearXNG instance."""
 
